{
  "$meta": {
    "name": "dongne-baedal",
    "version": "0.1.0",
    "note": "단일 원본. web은 npm run tokens, flutter는 dart run tool/gen_tokens.dart 로 생성"
  },
  "color": {
    "brand": {
      "50": "#FFF1ED",
      "100": "#FFDDD3",
      "200": "#FFBBA7",
      "300": "#FF9677",
      "400": "#FF7650",
      "500": "#FF5A36",
      "600": "#E84521",
      "700": "#C2361A",
      "800": "#9A2B16",
      "900": "#6E1F10"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F8F8F9",
      "100": "#F1F1F3",
      "200": "#E4E4E8",
      "300": "#CFCFD6",
      "400": "#A5A5B0",
      "500": "#7C7C89",
      "600": "#5B5B67",
      "700": "#41414B",
      "800": "#2A2A32",
      "900": "#17171C"
    },
    "semantic": {
      "success": "#1E9E5A",
      "warning": "#F5A524",
      "danger": "#E5484D",
      "info": "#2F7DE1"
    },
    "surface": {
      "background": "#FFFFFF",
      "card": "#FFFFFF",
      "muted": "#F8F8F9",
      "overlay": "#17171C99"
    },
    "text": {
      "primary": "#17171C",
      "secondary": "#5B5B67",
      "tertiary": "#7C7C89",
      "onBrand": "#FFFFFF"
    },
    "order": {
      "placed": "#F5A524",
      "accepted": "#2F7DE1",
      "preparing": "#2F7DE1",
      "ready": "#FF5A36",
      "pickedUp": "#FF5A36",
      "delivered": "#1E9E5A",
      "canceled": "#E5484D"
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "breakpoint": {
    "mobileMax": 767,
    "tabletMin": 768,
    "tabletMax": 1199,
    "desktopMin": 1200,
    "contentMaxWidth": 1120
  },
  "typography": {
    "fontFamily": {
      "sans": "Pretendard",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5
    },
    "responsive": {
      "display": { "mobile": 28, "tablet": 32, "desktop": 40 },
      "title": { "mobile": 20, "tablet": 22, "desktop": 24 },
      "subtitle": { "mobile": 17, "tablet": 18, "desktop": 20 },
      "body": { "mobile": 15, "tablet": 16, "desktop": 16 },
      "caption": { "mobile": 12, "tablet": 13, "desktop": 14 }
    }
  },
  "layout": {
    "storeGridColumns": { "mobile": 1, "tablet": 2, "desktop": 3 },
    "pagePadding": { "mobile": 16, "tablet": 24, "desktop": 32 },
    "bottomTabHeight": 56,
    "touchTargetMin": 44
  },
  "shadow": {
    "card": "0 1px 2px rgba(23,23,28,0.06), 0 2px 8px rgba(23,23,28,0.06)",
    "sheet": "0 -4px 24px rgba(23,23,28,0.12)"
  }
}
